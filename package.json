{
    "name": "guy",
    "displayName": "GUY - Control Flow Graphs",
    "description": "Visualize interactive control-flow graphs for Python, Java, PHP, C, Go, and Rust.",
    "version": "0.1.6",
    "publisher": "gm64x",
    "icon": "media/icon.png",
    "pricing": "Free",
    "qna": "https://github.com/gm64x/guy-vscode/issues",
    "keywords": [
        "control flow",
        "control flow graph",
        "cfg",
        "code visualization",
        "tree-sitter",
        "cyclomatic complexity",
        "code analysis",
        "python",
        "java",
        "php",
        "c",
        "go",
        "rust"
    ],
    "homepage": "https://github.com/gm64x/guy-vscode#readme",
    "bugs": {
        "url": "https://github.com/gm64x/guy-vscode/issues"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/gm64x/guy-vscode.git"
    },
    "galleryBanner": {
        "color": "#0f172a",
        "theme": "dark"
    },
    "license": "MIT",
    "engines": {
        "vscode": "^1.120.0"
    },
    "categories": [
        "Visualization",
        "Education",
        "Other"
    ],
    "activationEvents": [
        "onLanguage:python",
        "onLanguage:java",
        "onLanguage:php",
        "onLanguage:c",
        "onLanguage:go",
        "onLanguage:rust",
        "onCommand:guy.generateCfgFromFile",
        "onCommand:guy.generateCfgFromSelection",
        "onCommand:guy.generateCfgFromCurrentFunction",
        "onCommand:guy.toggleGraphDetailMode"
    ],
    "main": "./dist/extension.js",
    "contributes": {
        "commands": [
            {
                "command": "guy.generateCfgFromFile",
                "title": "Generate CFG from File",
                "category": "GUY",
                "icon": {
                    "light": "media/icons/git-branch-light.svg",
                    "dark": "media/icons/git-branch-dark.svg"
                }
            },
            {
                "command": "guy.generateCfgFromSelection",
                "title": "Generate CFG from Selection",
                "category": "GUY"
            },
            {
                "command": "guy.generateCfgFromCurrentFunction",
                "title": "Generate CFG from Current Function",
                "category": "GUY"
            },
            {
                "command": "guy.toggleGraphDetailMode",
                "title": "Toggle Simplified/Detailed CFG View",
                "category": "GUY"
            }
        ],
        "menus": {
            "editor/title": [
                {
                    "command": "guy.generateCfgFromFile",
                    "when": "resourceLangId == python || resourceLangId == java || resourceLangId == php || resourceLangId == c || resourceLangId == go || resourceLangId == rust",
                    "group": "navigation"
                }
            ],
            "editor/context": [
                {
                    "command": "guy.generateCfgFromSelection",
                    "when": "(resourceLangId == python || resourceLangId == java || resourceLangId == php || resourceLangId == c || resourceLangId == go || resourceLangId == rust) && editorHasSelection",
                    "group": "navigation"
                },
                {
                    "command": "guy.generateCfgFromCurrentFunction",
                    "when": "resourceLangId == python || resourceLangId == java || resourceLangId == php || resourceLangId == c || resourceLangId == go || resourceLangId == rust",
                    "group": "navigation"
                }
            ]
        },
        "configuration": {
            "title": "GUY",
            "properties": {
                "guy.autoOpenPreview": {
                    "type": "boolean",
                    "default": true,
                    "description": "Open the CFG preview automatically after generation."
                },
                "guy.graphLayout": {
                    "type": "string",
                    "default": "top-bottom",
                    "enum": [
                        "top-bottom",
                        "left-right"
                    ],
                    "description": "Default graph layout direction."
                },
                "guy.showMetricsPanel": {
                    "type": "boolean",
                    "default": true,
                    "description": "Show the metrics panel in the CFG preview."
                },
                "guy.highlightCodeOnNodeClick": {
                    "type": "boolean",
                    "default": true,
                    "description": "Highlight source code when nodes or edges are selected."
                },
                "guy.maxNodesBeforeWarning": {
                    "type": "number",
                    "default": 100,
                    "minimum": 10,
                    "description": "Show a visual complexity warning when the graph exceeds this number of nodes."
                },
                "guy.highComplexityThreshold": {
                    "type": "number",
                    "default": 10,
                    "minimum": 1,
                    "description": "Cyclomatic complexity threshold used to show lightweight suggestions."
                }
            }
        }
    },
    "scripts": {
        "vscode:prepublish": "npm run package",
        "compile": "npm run check-types && npm run lint && node esbuild.js",
        "watch": "npm-run-all -p watch:*",
        "watch:esbuild": "node esbuild.js --watch",
        "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
        "package": "npm run check-types && npm run lint && node esbuild.js --production",
        "package:vsix": "npm run package && vsce package",
        "compile-tests": "tsc -p . --outDir out",
        "watch-tests": "tsc -p . -w --outDir out",
        "pretest": "npm run compile-tests && npm run compile && npm run lint",
        "check-types": "tsc --noEmit",
        "lint": "eslint src",
        "test": "vscode-test",
        "setup:vscode": "./scripts/install-vscode-libs.sh",
        "vscode:dev": "bash ./scripts/vscode-dev.sh",
        "vscode:dev:gpu-off": "bash ./scripts/vscode-dev.sh --disable-gpu"
    },
    "dependencies": {
        "@dagrejs/dagre": "^3.0.0",
        "@xyflow/react": "^12.10.2",
        "react": "^19.2.6",
        "react-dom": "^19.2.6",
        "tree-sitter-c": "^0.24.1",
        "tree-sitter-java": "^0.23.5",
        "tree-sitter-php": "^0.24.2",
        "tree-sitter-python": "^0.23.6",
        "tree-sitter-wasm": "^1.1.4",
        "web-tree-sitter": "^0.26.8"
    },
    "devDependencies": {
        "@types/mocha": "^10.0.10",
        "@types/node": "22.x",
        "@types/react": "^19.2.14",
        "@types/react-dom": "^19.2.3",
        "@types/vscode": "^1.120.0",
        "@vscode/test-cli": "^0.0.15",
        "@vscode/test-electron": "^3.1.0",
        "@vscode/vsce": "^3.9.2",
        "esbuild": "^0.28.1",
        "eslint": "^9.39.3",
        "npm-run-all": "^4.1.5",
        "typescript": "^5.9.3",
        "typescript-eslint": "^8.56.1"
    }
}
